{
  "name": "joseikin-navi-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "generate:grants-runtime": "node scripts/generate-runtime-grants.mjs",
    "prebuild": "npm run generate:grants-runtime",
    "build": "next build --webpack",
    "start": "next start",
    "cf:build": "opennextjs-cloudflare build && node scripts/patch-opennext-html-cache.mjs",
    "cf:preview": "npm run cf:build && opennextjs-cloudflare preview",
    "cf:deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "cf:upload": "npm run cf:build && opennextjs-cloudflare upload",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint",
    "pretypecheck": "npm run generate:grants-runtime",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/lib/*.test.mjs",
    "test:e2e": "python3 scripts/run-e2e.py",
    "check:copy": "node scripts/check-public-copy.mjs",
    "audit:content": "node scripts/audit-content.mjs",
    "audit:affiliates": "node scripts/audit-affiliates.mjs",
    "audit:build": "node scripts/audit-build.mjs",
    "audit:coverage": "node scripts/audit-coverage.mjs",
    "audit:deadlines": "node --test src/lib/deadline.test.mjs src/lib/grant-status.test.mjs",
    "audit:links": "node scripts/audit-links.mjs",
    "audit:migration": "node scripts/audit-domain-migration.mjs",
    "seo:dedupe-exact": "node scripts/generate-exact-duplicate-redirects.mjs",
    "seo:article": "node scripts/run-seo-article-pipeline.mjs",
    "audit:seo-articles": "node scripts/run-seo-article-pipeline.mjs --audit",
    "assets:illustrations": "node scripts/process-illustration-sheets.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.0",
    "next": "^16.2.11",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "^16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.114.0"
  }
}
