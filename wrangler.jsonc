{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shienseido-navi",
  "main": ".open-next/worker.js",
  "workers_dev": true,
  "compatibility_date": "2026-07-25",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "shienseido-navi"
    }
  ],
  "routes": [
    {
      "pattern": "shienseido-navi.jp/*",
      "zone_name": "shienseido-navi.jp"
    },
    {
      "pattern": "www.shienseido-navi.jp/*",
      "zone_name": "shienseido-navi.jp"
    }
  ],
  "observability": {
    "enabled": true
  }
}
